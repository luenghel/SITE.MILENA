{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://pdwooahpyustbqlrvlxz.supabase.co wss://pdwooahpyustbqlrvlxz.supabase.co https://www.facebook.com https://connect.facebook.net; frame-src https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/f/:slug",
      "destination": "/pesquisa"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.sql",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.ts",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.zip",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.bak",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.BAK",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)\\.BAK\\.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/LEEME.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/PENDIENTE-CUANDO-TENGAMOS-DOMINIO.txt",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Correo-Pagopar",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Correo-Pagopar.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.git/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.vercelignore",
      "destination": "/",
      "permanent": false
    }
  ]
}